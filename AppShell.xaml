<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Myst3ry.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Myst3ry.Views"
    xmlns:local="clr-namespace:Myst3ry"
    Title="Myst3ry">

    <TabBar>
        <Tab Title="Play">
            <ShellContent ContentTemplate="{DataTemplate views:GamePage}" />
        </Tab>
        <Tab Title="Stats">
            <ShellContent ContentTemplate="{DataTemplate views:StatsPage}" />
        </Tab>
    </TabBar>
</Shell>
