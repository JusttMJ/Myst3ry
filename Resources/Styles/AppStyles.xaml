<?xml version="1.0" encoding="utf-8" ?>
<?xaml-comp compile="true" ?>
<!-- Myst3ry's own styles. Colours come from Colors.xaml so every screen uses the same palette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:models="clr-namespace:Myst3ry.Models"
                    xmlns:converters="clr-namespace:Myst3ry.Converters">

    <!-- Monospaced font so the timer digits don't jump around as they change -->
    <OnPlatform x:Key="MonoFont" x:TypeArguments="x:String">
        <On Platform="Android" Value="monospace" />
        <On Platform="iOS, MacCatalyst" Value="Menlo" />
        <On Platform="WinUI" Value="Consolas" />
    </OnPlatform>

    <!-- Green when the player won, red otherwise -->
    <converters:BoolToColorConverter x:Key="WinColorConverter"
                                     TrueColor="{StaticResource HitGreen}"
                                     FalseColor="{StaticResource Accent}" />

    <!-- ===== Text ===== -->

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource DarkText}}" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightSubtleText}, Dark={StaticResource DarkSubtleText}}" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
    </Style>

    <Style x:Key="CardTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource DarkText}}" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
    </Style>

    <Style x:Key="BodyText" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="1.3" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
    </Style>

    <Style x:Key="BodyStrong" TargetType="Label" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <Style x:Key="CaptionText" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightSubtleText}, Dark={StaticResource DarkSubtleText}}" />
    </Style>

    <Style x:Key="StatusText" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="MinimumHeightRequest" Value="42" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}" />
    </Style>

    <Style x:Key="ChipCaption" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightSubtleText}, Dark={StaticResource DarkSubtleText}}" />
    </Style>

    <Style x:Key="ChipValue" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource DarkText}}" />
    </Style>

    <Style x:Key="StatValue" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource DarkText}}" />
    </Style>

    <!-- ===== Containers ===== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightStroke}, Dark={StaticResource DarkStroke}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="Chip" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="8,6" />
    </Style>

    <Style x:Key="HistoryRow" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource Midnight}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style x:Key="SegmentContainer" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightTile}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- The three boxes that show the guess being typed -->
    <Style x:Key="GuessSlot" TargetType="Border">
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource LightStroke}, Dark={StaticResource DarkStroke}}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
    </Style>

    <Style x:Key="GuessSlotLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource DarkText}}" />
    </Style>

    <!-- A digit tile. Its colour follows the digit's clue (used in Easy mode and for the revealed code). -->
    <Style x:Key="DigitTile" TargetType="Border">
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightTile}, Dark={StaticResource DarkTile}}" />
        <Style.Triggers>
            <DataTrigger x:DataType="models:DigitFeedback" TargetType="Border"
                         Binding="{Binding State}" Value="{x:Static models:DigitState.Hit}">
                <Setter Property="BackgroundColor" Value="{StaticResource HitGreen}" />
            </DataTrigger>
            <DataTrigger x:DataType="models:DigitFeedback" TargetType="Border"
                         Binding="{Binding State}" Value="{x:Static models:DigitState.Match}">
                <Setter Property="BackgroundColor" Value="{StaticResource MatchAmber}" />
            </DataTrigger>
            <DataTrigger x:DataType="models:DigitFeedback" TargetType="Border"
                         Binding="{Binding State}" Value="{x:Static models:DigitState.Miss}">
                <Setter Property="BackgroundColor" Value="{StaticResource MissGray}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DigitTileLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource White}}" />
        <Style.Triggers>
            <DataTrigger x:DataType="models:DigitFeedback" TargetType="Label"
                         Binding="{Binding State}" Value="{x:Static models:DigitState.Hit}">
                <Setter Property="TextColor" Value="{StaticResource White}" />
            </DataTrigger>
            <DataTrigger x:DataType="models:DigitFeedback" TargetType="Label"
                         Binding="{Binding State}" Value="{x:Static models:DigitState.Match}">
                <Setter Property="TextColor" Value="{StaticResource Navy}" />
            </DataTrigger>
            <DataTrigger x:DataType="models:DigitFeedback" TargetType="Label"
                         Binding="{Binding State}" Value="{x:Static models:DigitState.Miss}">
                <Setter Property="TextColor" Value="{StaticResource White}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecretTile" TargetType="Border" BasedOn="{StaticResource DigitTile}">
        <Setter Property="WidthRequest" Value="58" />
        <Setter Property="HeightRequest" Value="58" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
    </Style>

    <Style x:Key="SecretTileLabel" TargetType="Label" BasedOn="{StaticResource DigitTileLabel}">
        <Setter Property="FontSize" Value="30" />
    </Style>

    <!-- Small coloured labels for "2 hits" / "1 match" -->
    <Style x:Key="HitPill" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource HitGreen}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="MatchPill" TargetType="Border" BasedOn="{StaticResource HitPill}">
        <Setter Property="BackgroundColor" Value="{StaticResource MatchAmber}" />
    </Style>

    <Style x:Key="HitPillLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
    </Style>

    <Style x:Key="MatchPillLabel" TargetType="Label" BasedOn="{StaticResource HitPillLabel}">
        <Setter Property="TextColor" Value="{StaticResource Navy}" />
    </Style>

    <!-- ===== Buttons ===== -->

    <Style x:Key="KeypadButton" TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LightStroke}, Dark={StaticResource DarkStroke}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource White}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.94" />
                        </VisualState.Setters>
                    </VisualState>
                    <!-- Used digits (and the keypad after a game ends) fade out -->
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.3" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="KeypadDeleteButton" TargetType="Button" BasedOn="{StaticResource KeypadButton}">
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightTile}, Dark={StaticResource DeepBlue}}" />
    </Style>

    <Style x:Key="KeypadSubmitButton" TargetType="Button" BasedOn="{StaticResource KeypadButton}">
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource HitGreen}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="Scale" Value="0.97" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="46" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource DeepBlue}}" />
    </Style>

    <Style x:Key="DangerOutlineButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="{StaticResource Accent}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="TextColor" Value="{StaticResource Accent}" />
    </Style>

    <!-- One option of the Easy / Normal / Hard selector. The selected one is coloured in GamePage.xaml. -->
    <Style x:Key="SegmentButton" TargetType="Button">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LightSubtleText}, Dark={StaticResource DarkSubtleText}}" />
    </Style>

</ResourceDictionary>
