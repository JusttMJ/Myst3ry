<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Myst3ry.Models"
             xmlns:vm="clr-namespace:Myst3ry.ViewModels"
             x:Class="Myst3ry.Views.StatsPage"
             x:DataType="vm:StatsViewModel"
             Title="Statistics">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <VerticalStackLayout Spacing="2">
                <Label Text="📊 Your progress" Style="{StaticResource PageTitle}" />
                <Label Text="{Binding Summary}" Style="{StaticResource CaptionText}" />
            </VerticalStackLayout>

            <!-- Games played / won / lost -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource Chip}" Padding="8,12">
                    <VerticalStackLayout>
                        <Label Text="{Binding GamesPlayed}" Style="{StaticResource StatValue}" />
                        <Label Text="PLAYED" Style="{StaticResource ChipCaption}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Chip}" Padding="8,12">
                    <VerticalStackLayout>
                        <Label Text="{Binding GamesWon}" Style="{StaticResource StatValue}" TextColor="{StaticResource HitGreen}" />
                        <Label Text="WON" Style="{StaticResource ChipCaption}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Chip}" Padding="8,12">
                    <VerticalStackLayout>
                        <Label Text="{Binding GamesLost}" Style="{StaticResource StatValue}" TextColor="{StaticResource Accent}" />
                        <Label Text="LOST" Style="{StaticResource ChipCaption}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Win rate with a progress bar -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="WIN RATE" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding WinRate}"
                               Style="{StaticResource CardTitle}"
                               VerticalOptions="Center" />
                    </Grid>
                    <ProgressBar Progress="{Binding WinRateProgress}"
                                 ProgressColor="{StaticResource HitGreen}"
                                 SemanticProperties.Description="{Binding WinRate, StringFormat='Win rate {0}'}" />
                </VerticalStackLayout>
            </Border>

            <!-- Best / average / fastest (wins only) -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource Chip}" Padding="8,12">
                    <VerticalStackLayout>
                        <Label Text="{Binding BestScore}" Style="{StaticResource StatValue}" />
                        <Label Text="BEST" Style="{StaticResource ChipCaption}" />
                        <Label Text="guesses" Style="{StaticResource CaptionText}" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Chip}" Padding="8,12">
                    <VerticalStackLayout>
                        <Label Text="{Binding AvgGuesses}" Style="{StaticResource StatValue}" />
                        <Label Text="AVERAGE" Style="{StaticResource ChipCaption}" />
                        <Label Text="guesses" Style="{StaticResource CaptionText}" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Chip}" Padding="8,12">
                    <VerticalStackLayout>
                        <Label Text="{Binding FastestWin}" Style="{StaticResource StatValue}" />
                        <Label Text="FASTEST" Style="{StaticResource ChipCaption}" />
                        <Label Text="win" Style="{StaticResource CaptionText}" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="RECENT GAMES" Style="{StaticResource SectionTitle}" Margin="0,6,0,0" />

            <!-- A BindableLayout (not a CollectionView) because the list is short and sits inside a ScrollView -->
            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding RecentGames}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ScoreEntry">
                        <Border Style="{StaticResource Card}"
                                Padding="14,10"
                                SemanticProperties.Description="{Binding Display}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Label Text="{Binding ResultIcon}"
                                       FontSize="24"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" Style="{StaticResource BodyStrong}" />
                                    <Label Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>

                <BindableLayout.EmptyView>
                    <Border Style="{StaticResource Card}" Padding="20">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="🎲" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="No games yet"
                                   Style="{StaticResource BodyStrong}"
                                   HorizontalOptions="Center" />
                            <Label Text="Finish a game on the Play tab and it will show up here."
                                   Style="{StaticResource CaptionText}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </BindableLayout.EmptyView>
            </VerticalStackLayout>

            <Button Text="Clear History"
                    Clicked="OnClearClicked"
                    IsEnabled="{Binding HasGames}"
                    Style="{StaticResource DangerOutlineButton}"
                    Margin="0,6,0,0"
                    SemanticProperties.Hint="Deletes all saved games and statistics" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
