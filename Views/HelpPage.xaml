<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Myst3ry.Views.HelpPage"
             Title="How to Play">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <VerticalStackLayout Spacing="6">
                <Label Text="🔐 Crack the code!" Style="{StaticResource PageTitle}" />
                <Label Style="{StaticResource BodyText}"
                       Text="Myst3ry has picked a secret three-digit number. All three digits are different and it never starts with 0. Find it in as few guesses as you can." />
            </VerticalStackLayout>

            <!-- Step 1 -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="1 · Enter a guess" Style="{StaticResource CardTitle}" />
                    <Label Style="{StaticResource BodyText}"
                           Text="Tap three digits on the keypad. Digits you have already used are greyed out, because the code never repeats a digit." />
                    <Label Style="{StaticResource BodyText}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="⌫ " FontAttributes="Bold" />
                                <Span Text="deletes the last digit.  " />
                                <Span Text="✓ " FontAttributes="Bold" />
                                <Span Text="submits your guess." />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Step 2 -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="2 · Read the clues" Style="{StaticResource CardTitle}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Style="{StaticResource HitPill}">
                            <Label Text="hit" Style="{StaticResource HitPillLabel}" />
                        </Border>
                        <Label Grid.Column="1" Style="{StaticResource BodyText}" VerticalOptions="Center"
                               Text="A correct digit in the correct place." />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Style="{StaticResource MatchPill}">
                            <Label Text="match" Style="{StaticResource MatchPillLabel}" />
                        </Border>
                        <Label Grid.Column="1" Style="{StaticResource BodyText}" VerticalOptions="Center"
                               Text="A correct digit in the wrong place." />
                    </Grid>

                    <!-- Worked example: secret 586, guess 856 -->
                    <Border Style="{StaticResource HistoryRow}" Padding="12" Margin="0,4,0,0">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="EXAMPLE" Style="{StaticResource SectionTitle}" />
                            <Grid ColumnDefinitions="70,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                <Label Text="Secret" Style="{StaticResource CaptionText}" VerticalOptions="Center" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                    <Border Style="{StaticResource DigitTile}"><Label Text="5" Style="{StaticResource DigitTileLabel}" /></Border>
                                    <Border Style="{StaticResource DigitTile}"><Label Text="8" Style="{StaticResource DigitTileLabel}" /></Border>
                                    <Border Style="{StaticResource DigitTile}"><Label Text="6" Style="{StaticResource DigitTileLabel}" /></Border>
                                </HorizontalStackLayout>

                                <Label Grid.Row="1" Text="Your guess" Style="{StaticResource CaptionText}" VerticalOptions="Center" />
                                <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                    <Border Style="{StaticResource DigitTile}"><Label Text="8" Style="{StaticResource DigitTileLabel}" /></Border>
                                    <Border Style="{StaticResource DigitTile}"><Label Text="5" Style="{StaticResource DigitTileLabel}" /></Border>
                                    <Border Style="{StaticResource DigitTile}"><Label Text="6" Style="{StaticResource DigitTileLabel}" /></Border>
                                </HorizontalStackLayout>

                                <Label Grid.Row="2" Text="Clues" Style="{StaticResource CaptionText}" VerticalOptions="Center" />
                                <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="6">
                                    <Border Style="{StaticResource HitPill}"><Label Text="1 hit" Style="{StaticResource HitPillLabel}" /></Border>
                                    <Border Style="{StaticResource MatchPill}"><Label Text="2 matches" Style="{StaticResource MatchPillLabel}" /></Border>
                                </HorizontalStackLayout>
                            </Grid>
                            <Label Style="{StaticResource CaptionText}"
                                   Text="6 is in the right place (1 hit). 8 and 5 are in the code but swapped (2 matches)." />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Step 3 -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="3 · Pick a difficulty" Style="{StaticResource CardTitle}" />

                    <Label Style="{StaticResource BodyText}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Easy: " FontAttributes="Bold" />
                                <Span Text="every digit of your guess is coloured to show its clue:" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <HorizontalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="6">
                            <Border Style="{StaticResource DigitTile}" BackgroundColor="{StaticResource HitGreen}">
                                <Label Text="6" Style="{StaticResource DigitTileLabel}" TextColor="{StaticResource White}" />
                            </Border>
                            <Label Text="hit" Style="{StaticResource CaptionText}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="6">
                            <Border Style="{StaticResource DigitTile}" BackgroundColor="{StaticResource MatchAmber}">
                                <Label Text="8" Style="{StaticResource DigitTileLabel}" TextColor="{StaticResource Navy}" />
                            </Border>
                            <Label Text="match" Style="{StaticResource CaptionText}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="6">
                            <Border Style="{StaticResource DigitTile}" BackgroundColor="{StaticResource MissGray}">
                                <Label Text="2" Style="{StaticResource DigitTileLabel}" TextColor="{StaticResource White}" />
                            </Border>
                            <Label Text="not in code" Style="{StaticResource CaptionText}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>

                    <Label Style="{StaticResource BodyText}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Normal: " FontAttributes="Bold" />
                                <Span Text="you only see how many hits and matches you got." />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Style="{StaticResource BodyText}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Hard: " FontAttributes="Bold" />
                                <Span Text="like Normal, but you have only 60 seconds. The clock turns red in the last 10 seconds." />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Tips -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="💡 Tips" Style="{StaticResource CardTitle}" />
                    <Label Style="{StaticResource BodyText}"
                           Text="• A guess with 0 hits and 0 matches rules out all three of its digits." />
                    <Label Style="{StaticResource BodyText}"
                           Text="• 3 hits wins! Your number of guesses and time are saved on the Stats tab." />
                    <Label Style="{StaticResource BodyText}"
                           Text="• The clock starts on your first tap and pauses while you are on another screen." />
                    <Label Style="{StaticResource BodyText}"
                           Text="• Stuck? Tap Give Up to reveal the code, or New Game to start again." />
                </VerticalStackLayout>
            </Border>

            <Button Text="Got it, let's play!"
                    Clicked="OnGotItClicked"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,4,0,8" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
