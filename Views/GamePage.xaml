<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Myst3ry.ViewModels"
             xmlns:models="clr-namespace:Myst3ry.Models"
             x:Class="Myst3ry.Views.GamePage"
             x:DataType="vm:GameViewModel"
             Title="Myst3ry">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="How to play"
                     IconImageSource="help.png"
                     Clicked="OnHelpClicked"
                     SemanticProperties.Description="How to play" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" Padding="16,12,16,16">

        <!-- ===== Row 0: difficulty selector ===== -->
        <VerticalStackLayout Grid.Row="0" Spacing="6">
            <Border Style="{StaticResource SegmentContainer}">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                    <Button Grid.Column="0"
                            Text="Easy"
                            CommandParameter="{x:Static models:Difficulty.Easy}"
                            Clicked="OnDifficultyClicked"
                            Style="{StaticResource SegmentButton}"
                            SemanticProperties.Hint="Start an easy game with coloured clues">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding Difficulty}" Value="{x:Static models:Difficulty.Easy}">
                                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1"
                            Text="Normal"
                            CommandParameter="{x:Static models:Difficulty.Normal}"
                            Clicked="OnDifficultyClicked"
                            Style="{StaticResource SegmentButton}"
                            SemanticProperties.Hint="Start a normal game">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding Difficulty}" Value="{x:Static models:Difficulty.Normal}">
                                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="2"
                            Text="Hard ⏱"
                            CommandParameter="{x:Static models:Difficulty.Hard}"
                            Clicked="OnDifficultyClicked"
                            Style="{StaticResource SegmentButton}"
                            SemanticProperties.Hint="Start a hard game with a 60 second time limit">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding Difficulty}" Value="{x:Static models:Difficulty.Hard}">
                                <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>

            <Label Text="{Binding DifficultyDescription}"
                   Style="{StaticResource CaptionText}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- ===== Row 1: timer, guess count and best score ===== -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <Border x:Name="TimerChip" Grid.Column="0" Style="{StaticResource Chip}">
                <VerticalStackLayout>
                    <Label Text="{Binding TimerCaption}" Style="{StaticResource ChipCaption}" />
                    <Label Text="{Binding TimerDisplay}"
                           Style="{StaticResource ChipValue}"
                           FontFamily="{StaticResource MonoFont}"
                           SemanticProperties.Description="{Binding TimerDisplay, StringFormat='Time {0}'}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsTimeLow}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Chip}">
                <VerticalStackLayout>
                    <Label Text="{Binding GuessesCaption}" Style="{StaticResource ChipCaption}" />
                    <Label Text="{Binding GuessCount}" Style="{StaticResource ChipValue}" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Chip}">
                <VerticalStackLayout>
                    <Label Text="BEST" Style="{StaticResource ChipCaption}" />
                    <Label Text="{Binding BestDisplay}"
                           Style="{StaticResource ChipValue}"
                           SemanticProperties.Description="{Binding BestDisplay, StringFormat='Best score {0} guesses'}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ===== Row 2: guess history (newest first) ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,10">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <Label Text="GUESS HISTORY" Style="{StaticResource SectionTitle}" />

                <CollectionView x:Name="HistoryList"
                                Grid.Row="1"
                                ItemsSource="{Binding GuessHistory}"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:GuessResult">
                            <Border Style="{StaticResource HistoryRow}"
                                    SemanticProperties.Description="{Binding Display}">
                                <Grid ColumnDefinitions="30,Auto,*" ColumnSpacing="10">
                                    <Label Text="{Binding NumberText}"
                                           Style="{StaticResource CaptionText}"
                                           VerticalOptions="Center" />

                                    <HorizontalStackLayout Grid.Column="1"
                                                           Spacing="4"
                                                           BindableLayout.ItemsSource="{Binding Digits}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:DigitFeedback">
                                                <Border Style="{StaticResource DigitTile}">
                                                    <Label Text="{Binding Digit}" Style="{StaticResource DigitTileLabel}" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Grid.Column="2"
                                                           Spacing="6"
                                                           HorizontalOptions="End"
                                                           VerticalOptions="Center">
                                        <Border Style="{StaticResource HitPill}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding HasHits}" Value="False">
                                                    <Setter Property="Opacity" Value="0.35" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding HitsText}" Style="{StaticResource HitPillLabel}" />
                                        </Border>
                                        <Border Style="{StaticResource MatchPill}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding HasMatches}" Value="False">
                                                    <Setter Property="Opacity" Value="0.35" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding MatchesText}" Style="{StaticResource MatchPillLabel}" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="4" Padding="10">
                            <Label Text="🔐" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="No guesses yet"
                                   Style="{StaticResource BodyStrong}"
                                   HorizontalOptions="Center" />
                            <Label Text="Each guess and its clues will appear here."
                                   Style="{StaticResource CaptionText}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>
        </Border>

        <!-- ===== Row 3: keypad while playing, result card when the game is over ===== -->
        <Grid Grid.Row="3">

            <VerticalStackLayout IsVisible="{Binding IsPlaying}" Spacing="10">

                <!-- The guess being typed; the next empty slot is highlighted -->
                <Grid x:Name="SlotsGrid"
                      ColumnDefinitions="*,*,*"
                      ColumnSpacing="10"
                      WidthRequest="234"
                      HorizontalOptions="Center"
                      SemanticProperties.Description="{Binding CurrentGuess, StringFormat='Current guess {0}'}">
                    <Border Grid.Column="0" Style="{StaticResource GuessSlot}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ActiveSlot}" Value="0">
                                <Setter Property="Stroke" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Slot1}" Style="{StaticResource GuessSlotLabel}" />
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource GuessSlot}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ActiveSlot}" Value="1">
                                <Setter Property="Stroke" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Slot2}" Style="{StaticResource GuessSlotLabel}" />
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource GuessSlot}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ActiveSlot}" Value="2">
                                <Setter Property="Stroke" Value="{StaticResource Accent}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding Slot3}" Style="{StaticResource GuessSlotLabel}" />
                    </Border>
                </Grid>

                <Label x:Name="StatusLabel"
                       Text="{Binding StatusMessage}"
                       Style="{StaticResource StatusText}" />

                <!-- Number keypad. Digits already in the guess are disabled because the code never repeats a digit. -->
                <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnDefinitions="*,*,*"
                      RowSpacing="8"
                      ColumnSpacing="8">

                    <Button Grid.Row="0" Grid.Column="0" Text="1"
                            CommandParameter="1" Command="{Binding DigitCommand}" Style="{StaticResource KeypadButton}" />
                    <Button Grid.Row="0" Grid.Column="1" Text="2"
                            CommandParameter="2" Command="{Binding DigitCommand}" Style="{StaticResource KeypadButton}" />
                    <Button Grid.Row="0" Grid.Column="2" Text="3"
                            CommandParameter="3" Command="{Binding DigitCommand}" Style="{StaticResource KeypadButton}" />

                    <Button Grid.Row="1" Grid.Column="0" Text="4"
                            CommandParameter="4" Command="{Binding DigitCommand}" Style="{StaticResource KeypadButton}" />
                    <Button Grid.Row="1" Grid.Column="1" Text="5"
                            CommandParameter="5" Command="{Binding DigitCommand}" Style="{StaticResource KeypadButton}" />
                    <Button Grid.Row="1" Grid.Column="2" Text="6"
                            CommandParameter="6" Command="{Binding DigitCommand}" Style="{StaticResource KeypadButton}" />

                    <Button Grid.Row="2" Grid.Column="0" Text="7"
                            CommandParameter="7" Command="{Binding DigitCommand}" Style="{StaticResource KeypadButton}" />
                    <Button Grid.Row="2" Grid.Column="1" Text="8"
                            CommandParameter="8" Command="{Binding DigitCommand}" Style="{StaticResource KeypadButton}" />
                    <Button Grid.Row="2" Grid.Column="2" Text="9"
                            CommandParameter="9" Command="{Binding DigitCommand}" Style="{StaticResource KeypadButton}" />

                    <Button Grid.Row="3" Grid.Column="0" Text="⌫"
                            Command="{Binding BackspaceCommand}"
                            Style="{StaticResource KeypadDeleteButton}"
                            SemanticProperties.Description="Delete last digit" />
                    <Button Grid.Row="3" Grid.Column="1" Text="0"
                            CommandParameter="0" Command="{Binding DigitCommand}" Style="{StaticResource KeypadButton}" />
                    <Button Grid.Row="3" Grid.Column="2" Text="✓"
                            Command="{Binding SubmitCommand}"
                            Style="{StaticResource KeypadSubmitButton}"
                            SemanticProperties.Description="Submit guess" />
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0"
                            Text="New Game"
                            Clicked="OnNewGameClicked"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Grid.Column="1"
                            Text="Give Up"
                            Clicked="OnGiveUpClicked"
                            Style="{StaticResource DangerOutlineButton}"
                            SemanticProperties.Hint="Reveals the secret code and ends the game" />
                </Grid>
            </VerticalStackLayout>

            <!-- Shown when the game ends: the outcome, the code and the number of guesses -->
            <Border x:Name="ResultCard"
                    IsVisible="{Binding IsGameOver}"
                    Style="{StaticResource Card}"
                    Padding="20,18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding ResultTitle}"
                           FontFamily="OpenSansSemibold"
                           FontSize="24"
                           HorizontalTextAlignment="Center"
                           TextColor="{Binding IsWon, Converter={StaticResource WinColorConverter}}"
                           SemanticProperties.HeadingLevel="Level1" />

                    <Label Text="The secret code was"
                           Style="{StaticResource CaptionText}"
                           HorizontalTextAlignment="Center" />

                    <HorizontalStackLayout HorizontalOptions="Center"
                                           Spacing="8"
                                           BindableLayout.ItemsSource="{Binding SecretDigits}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:DigitFeedback">
                                <Border Style="{StaticResource SecretTile}">
                                    <Label Text="{Binding Digit}" Style="{StaticResource SecretTileLabel}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding GuessCount}" Style="{StaticResource StatValue}" />
                            <Label Text="{Binding GuessesCaption}" Style="{StaticResource ChipCaption}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="{Binding ElapsedDisplay}" Style="{StaticResource StatValue}" />
                            <Label Text="TIME TAKEN" Style="{StaticResource ChipCaption}" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="{Binding ResultMessage}"
                           Style="{StaticResource BodyText}"
                           HorizontalTextAlignment="Center" />

                    <Label Text="{Binding BestMessage}"
                           IsVisible="{Binding IsNewBest}"
                           Style="{StaticResource BodyStrong}"
                           TextColor="{AppThemeBinding Light={StaticResource Navy}, Dark={StaticResource MatchAmber}}"
                           HorizontalTextAlignment="Center" />

                    <Button Text="Play Again"
                            Command="{Binding NewGameCommand}"
                            Style="{StaticResource PrimaryButton}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
