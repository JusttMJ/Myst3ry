<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Myst3ry.ViewModels"
             xmlns:models="clr-namespace:Myst3ry.Models"
             x:Class="Myst3ry.Views.GamePage"
             x:DataType="vm:GameViewModel"
             Title="Myst3ry"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1A1A2E}">

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Padding="15">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,10,0,10">
            <Label Grid.Column="0"
                   Text="🔐 Myst3ry"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#16213E, Dark=#E94560}"
                   VerticalOptions="Center" />

            <Picker Grid.Column="1"
                    ItemsSource="{Binding Difficulties}"
                    SelectedItem="{Binding Difficulty}"
                    TextColor="{AppThemeBinding Light=#16213E, Dark=#FFFFFF}"
                    Title="Difficulty"
                    VerticalOptions="Center" />

            <Border Grid.Column="2"
                    Stroke="{AppThemeBinding Light=#16213E, Dark=#E94560}"
                    StrokeThickness="2"
                    Padding="10,5"
                    BackgroundColor="Transparent">
                <Label Text="{Binding TimerDisplay}"
                       FontSize="18"
                       FontFamily="RobotoMono"
                       TextColor="{AppThemeBinding Light=#16213E, Dark=#FFFFFF}" />
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Stroke="#DDDDDD"
                StrokeThickness="1"
                Padding="10"
                Margin="0,5,0,10">
            <ScrollView>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Guess History"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="Gray" />

                    <CollectionView ItemsSource="{Binding GuessHistory}"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:GuessResult">
                                <Border Stroke="#5B36EC"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 6"
                                        Padding="8,4"
                                        Margin="0,2">
                                    <Label Text="{Binding Display}"
                                           FontSize="16"
                                           FontFamily="RobotoMono"
                                           TextColor="#333333" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                        <CollectionView.EmptyView>
                            <Label Text="No guesses yet — start playing!"
                                   FontSize="14"
                                   TextColor="Gray"
                                   HorizontalOptions="Center"
                                   Padding="20" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="10"
              Margin="0,5,0,10">
            <Border Grid.Column="0" Stroke="#E94560" StrokeThickness="2" Padding="15">
                <Label Text="{Binding Slot1}" FontSize="30" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#16213E, Dark=#FFFFFF}" />
            </Border>
            <Border Grid.Column="1" Stroke="#E94560" StrokeThickness="2" Padding="15">
                <Label Text="{Binding Slot2}" FontSize="30" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#16213E, Dark=#FFFFFF}" />
            </Border>
            <Border Grid.Column="2" Stroke="#E94560" StrokeThickness="2" Padding="15">
                <Label Text="{Binding Slot3}" FontSize="30" FontAttributes="Bold"
                       HorizontalOptions="Center" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#16213E, Dark=#FFFFFF}" />
            </Border>
        </Grid>

        <VerticalStackLayout Grid.Row="3" Spacing="10">
            <Label Text="{Binding StatusMessage}"
                   FontSize="15"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#333333, Dark=#EEEEEE}" />

            <Border IsVisible="{Binding IsWon}"
                    Stroke="#4CAF50"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}"
                    Padding="16,10"
                    HorizontalOptions="Center"
                    Margin="0,0,0,5">
                <VerticalStackLayout Spacing="4">
                    <Label Text="The code was:"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A5D6A7}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding SecretCodeDisplay}"
                           FontSize="48"
                           FontAttributes="Bold"
                           FontFamily="RobotoMono"
                           CharacterSpacing="8"
                           TextColor="{AppThemeBinding Light=#1B5E20, Dark=#C8E6C9}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="4" RowDefinitions="Auto,Auto" RowSpacing="10">

            <Grid Grid.Row="0"
                  RowDefinitions="*,*,*,*"
                  ColumnDefinitions="*,*,*"
                  RowSpacing="6"
                  ColumnSpacing="6">

                <Button Grid.Row="0" Grid.Column="0" Text="1"
                        Command="{Binding DigitCommand}" CommandParameter="1" Style="{StaticResource KeypadButton}" />
                <Button Grid.Row="0" Grid.Column="1" Text="2"
                        Command="{Binding DigitCommand}" CommandParameter="2" Style="{StaticResource KeypadButton}" />
                <Button Grid.Row="0" Grid.Column="2" Text="3"
                        Command="{Binding DigitCommand}" CommandParameter="3" Style="{StaticResource KeypadButton}" />

                <Button Grid.Row="1" Grid.Column="0" Text="4"
                        Command="{Binding DigitCommand}" CommandParameter="4" Style="{StaticResource KeypadButton}" />
                <Button Grid.Row="1" Grid.Column="1" Text="5"
                        Command="{Binding DigitCommand}" CommandParameter="5" Style="{StaticResource KeypadButton}" />
                <Button Grid.Row="1" Grid.Column="2" Text="6"
                        Command="{Binding DigitCommand}" CommandParameter="6" Style="{StaticResource KeypadButton}" />

                <Button Grid.Row="2" Grid.Column="0" Text="7"
                        Command="{Binding DigitCommand}" CommandParameter="7" Style="{StaticResource KeypadButton}" />
                <Button Grid.Row="2" Grid.Column="1" Text="8"
                        Command="{Binding DigitCommand}" CommandParameter="8" Style="{StaticResource KeypadButton}" />
                <Button Grid.Row="2" Grid.Column="2" Text="9"
                        Command="{Binding DigitCommand}" CommandParameter="9" Style="{StaticResource KeypadButton}" />

                <Button Grid.Row="3" Grid.Column="0" Text="⌫"
                        Style="{StaticResource KeypadButton}"
                        BackgroundColor="#E94560"
                        Command="{Binding BackspaceCommand}" />
                <Button Grid.Row="3" Grid.Column="1" Text="0"
                        Command="{Binding DigitCommand}" CommandParameter="0" Style="{StaticResource KeypadButton}" />
                <Button Grid.Row="3" Grid.Column="2" Text="✓"
                        Style="{StaticResource KeypadButton}"
                        BackgroundColor="#4CAF50"
                        Command="{Binding SubmitCommand}" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="🔄 New Game"
                        Command="{Binding NewGameCommand}"
                        BackgroundColor="{AppThemeBinding Light=#16213E, Dark=#0F3460}"
                        TextColor="White"
                        CornerRadius="8" />
                <Button Grid.Column="1"
                        Text="❓ Help"
                        Command="{Binding ShowHelpCommand}"
                        BackgroundColor="{AppThemeBinding Light=#16213E, Dark=#0F3460}"
                        TextColor="White"
                        CornerRadius="8" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>   